  },
  "dependencies": {
    "@rex/kernel": "git+file:///E:/backups/reality-sim/git/kernel.git#v0.1.1"
  },
  "devDependencies": {
    "@rex/realism": "file:../realism",
    "typescript": "~6.0.2",
    "vitest": "^5.0.5"
  },
  "exports": {
    ".": "./src/index.ts"
  }
}
